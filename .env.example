STRAVA_CREDENTIALS_DIR=/home/ezhil/.config/strava-mcp/profiles
STRAVA_DEFAULT_PROFILE=personal
STRAVA_CREDENTIAL_PROFILE=personal
STRAVA_MCP_TRANSPORT=streamable-http
STRAVA_MCP_HOST=127.0.0.1
STRAVA_MCP_PORT=8001

# Used by tunnel-client, not by server.py.
CONTROL_PLANE_API_KEY=replace-with-your-runtime-api-key
STRAVA_TUNNEL_ID=replace-with-your-strava-tunnel-id
TUNNEL_HEALTH_LISTEN_ADDR=127.0.0.1:8081

# Use exactly one of these when you do not want a profile JSON file.
# Keep the cookie private; it grants access to the Strava account.
STRAVA_SESSION_COOKIE=
STRAVA_ACCESS_TOKEN=
